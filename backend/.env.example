DATABASE_URL=
SUME_DEMO_CODE=
# For local runs, set a Gateway key or run in Vercel's authenticated dev environment.
AI_GATEWAY_API_KEY=
SUME_MODEL=google/gemini-2.5-flash-lite
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_CREATOR_A=
PAYPAL_SANDBOX_CREATOR_B=

# Persistent agent foundation. Use a stable URL registered with Google.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified Google users admitted to metered tasks without the shared preview code.
AGENT_ALLOWED_EMAILS=
# Shared minimum interval between foundation model calls (default 16 seconds).
AGENT_MODEL_INTERVAL_MS=16000

# Foundation model; campaign SUME_MODEL also uses the shared cheap-model budget guard.
AGENT_MODEL=amazon/nova-micro
# Shared UTC daily conservative inference reservations (default $5; max $15).
AGENT_MODEL_DAILY_USD=5

# Google Drive per-file OAuth setup (separate from identity; consent deferred).
# Enable Drive and Picker APIs; restrict this public API key to the preview origin.
GOOGLE_PICKER_API_KEY=

# AG Studio trial/license (public browser license, never provider credentials)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Server-only retail discovery for office snacks. No merchant checkout.
CHANNEL3_API_KEY=
# Local-only friend switcher; disabled unless explicitly enabled on localhost.
GIFT_DEMO_ENABLED=false

# Tool-enabled unified chat; shares existing price/capacity/daily guards.
WORKSPACE_CHAT_MODEL=google/gemini-2.5-flash-lite

# Optional, separate private code for isolated judge sessions.
SUME_JUDGE_CODE=
